{
  "expo": {
    "name": "Preach Radio",
    "slug": "preach-radio-mobile",
    "scheme": "preachradio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.preachradio.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSPhotoLibraryUsageDescription": "Choose a profile photo or a cover for your messages.",
        "NSMicrophoneUsageDescription": "Record audio messages and go live."
      }
    },
    "android": {
      "package": "com.preachradio.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo or a cover for your messages."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record audio messages and go live.",
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Add the city where a message was preached, so listeners nearby can find it."
        }
      ],
      "expo-asset"
    ]
  }
}
